# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

AUTH_SECRET=

# Transcription (batch, post-meeting) + Summarization / Minutes / Decisions / Action Items
GEMINI_API_KEY=

# Background processing
# Local dev: set INNGEST_DEV=1 and leave EVENT_KEY/SIGNING_KEY empty, then run
# `npx inngest-cli@latest dev` in a separate terminal — no cloud account needed.
# Only fill in EVENT_KEY/SIGNING_KEY (from app.inngest.com) when deploying to production.
INNGEST_DEV=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Zoom
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
